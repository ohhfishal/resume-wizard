package card

import (
	"fmt"
	"github.com/ohhfishal/resume-wizard/db"
	"strings"
	"time"
)


templ ResumeCard(resumes []db.Resume) {
	@Card(CardProps{}) {
		<div class="card-header">
			<h3>{ "Resumes" }</h3>
			<div class="card-meta">
				<span class="count-badge">{ len(resumes) } Resumes</span>
        <a href="/resume" class="button btn-add" hx-boost="true">+ Add New </a>
			</div>
		</div>
		@ResumeList(resumes)
	}
}

templ ResumeList(resumes []db.Resume) {
	// TODO: Update on deletes or adds or edits
	<div
		class="resume-list"
		hx-get="/components/baseResumeList"
		hx-swap="outerHTML"
		hx-trigger="none"
	>
		for _, resume := range resumes {
			@ResumeItem(resume)
		}
	</div>
}

templ ResumeItem(resume db.Resume) {
	{{
	metadata := []string{
		"Uploaded " + resume.CreatedAt.Format(time.DateOnly),
	}
	if resume.LastUsed.Valid {
		metadata = append(metadata,
			fmt.Sprintf("%s%s", metadata, resume.LastUsed.Time),
		)
	}
	}}
	<div class="resume-item">
		<div class="resume-info">
			<h4>{ resume.Name }</h4>
			<p>{ strings.Join(metadata, " • ") }</p>
		</div>
		<div hx-boost="true" class="resume-actions">
			<a
				href={ fmt.Sprintf("/apply/%d", resume.ID) }
				class="button btn-small"
			>Apply</a>
			<a
				href={ fmt.Sprintf("/resume/view?id=%d", resume.ID) }
				hx-boost="false"
				class="button btn-small"
			>View</a>
			<a
				href={ fmt.Sprintf("/resume/edit?id=%d", resume.ID) }
				hx-boost="false"
				class="button btn-small"
			>Edit</a>
			<button class="btn-small">Delete</button>
		</div>
	</div>
}
