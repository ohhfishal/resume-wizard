{
  "name": "Resume Wizard",
  "description": "Perform magic!",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "index.html"
  }
}
